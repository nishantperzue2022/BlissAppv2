<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Callback.RequestCallbackPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    Title="Request Callback"
    Background="{StaticResource BackgroudColor}"
    NavigationPage.HasNavigationBar="False"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">


    <ScrollView>


        <StackLayout Margin="15">
            <VerticalStackLayout>
                <sfCore:SfTextInputLayout
                    Margin="0,0,0,0"
                    ErrorText="{Binding PhoneNoErrorText}"
                    HasError="{Binding IsPhoneNoHasError}"
                    Hint="Phone Number"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">
                    <Entry
                        Margin="0"
                        Keyboard="Text"
                        Text="{Binding PhoneNumber}"
                        VerticalOptions="Center" />
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="18" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                </sfCore:SfTextInputLayout>

                <sfCore:SfTextInputLayout
                    ContainerBackground="White"
                    ContainerType="Outlined"
                    ErrorText="{Binding DescriptionErrorText}"
                    HasError="{Binding IsDescriptionHasError}"
                    Hint="Description"
                    IsHintAlwaysFloated="true"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="18" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                    <Editor
                        AutoSize="TextChanges"
                        HeightRequest="100"
                        Text="{Binding Description}"
                        VerticalOptions="Center" />
                </sfCore:SfTextInputLayout>


                <Label
                    Padding="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource LabelMedium}"
                    Text="Expect to receive callback in the next 50 minutes."
                    VerticalOptions="Center" />


                <ActivityIndicator
                    HorizontalOptions="Fill"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </VerticalStackLayout>

            <StackLayout VerticalOptions="End">

                <Button
                    Command="{Binding SubmitCallbackCommand}"
                    HorizontalOptions="Fill"
                    Style="{StaticResource BaseButton}"
                    Text="Submit"
                    VerticalOptions="Start" />


                <!--<Button
                    Command="{Binding GoToDetailsCommand}"
                           Style="{StaticResource ButtonOutline}"
                    Text="View History"
                 />-->
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>