            <editors:SfAutocomplete
                x:Name="autocomplete"
                DisplayMemberPath="Name"
                IsClearButtonVisible="False"
                ItemsSource="{Binding Medicines}"
                MaxDropDownHeight="250"
                SelectedValuePath="ID"
                SelectionChanged="OnSelectionChanged"
                Stroke="{StaticResource Tertiary}"
                TextMemberPath="Name"
                TextSearchMode="Contains" />



        </StackLayout>
        <StackLayout Margin="20">


            <Image
                HeightRequest="110"
                Source="search_new"
                WidthRequest="110" />
            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource LabelMedium}"
                Text="Search using generic (Active ingredients) or brand name."
                VerticalOptions="Center" />

            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource LabelMedium}"
                Text="Type first 3 letters of the items you want and select it from the dropdown menu."
                VerticalOptions="Center" />
        </StackLayout>
    </VerticalStackLayout>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding GetListOfMedicinesCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
</ContentPage>