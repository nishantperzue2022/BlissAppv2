<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Pharmacy.AddToCartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:BlissApp.ViewModels"
    Title="Add To Cart"
    x:DataType="viewmodel:CartViewModel"
    Background="{StaticResource BackgroudColor}"
    NavigationPage.HasNavigationBar="False"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">

    <Grid RowDefinitions="Auto,*,*,*,Auto">
        <VerticalStackLayout Grid.Row="0" Margin="15">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="Start"
                Text="{Binding MedicineDTO.Name}"
                VerticalOptions="Start" />



            <Grid
                Margin="0,10,0,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="10">


                <sfCore:SfTextInputLayout
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    ContainerType="None"
                    ErrorText="{Binding QuantityValueErrorText}"
                    HasError="{Binding QuantityValueHasError}"
                    Hint="Quantity"
                    HorizontalOptions="Center"
                    IsHintAlwaysFloated="true">
                    <editors:SfNumericEntry
                        FontSize="12"
                        Minimum="1"
                        ShowClearButton="False"
                        UpDownButtonColor="{StaticResource AppGreenColor}"
                        UpDownPlacementMode="Inline"
                        Value="{Binding QuantityValue}" />
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontSize="24" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                </sfCore:SfTextInputLayout>




                <sfCore:SfTextInputLayout
                    Grid.Column="1"
                    ContainerType="None"
                    ErrorText="{Binding PackegingErrorText}"
                    HasError="{Binding PackagingHasError}"
                    Hint="Packaging"
                    IsHintAlwaysFloated="true">
                    <editors:SfComboBox
                        Margin="0,10,0,0"
                        ClearButtonIconColor="{StaticResource AppGreenColor}"
                        ClipToBounds="True"
                        DropDownIconColor="{StaticResource AppGreenColor}"
                        FontSize="15"
                        IsClearButtonVisible="False"
                        ItemsSource="{Binding Items}"
                        MaxDropDownHeight="300"
                        SelectedItem="{Binding SelectedItem}"
                        Stroke="{StaticResource Tertiary}">
                        <editors:SfComboBox.ItemTemplate>
                            <DataTemplate>
                                <Label
                                    Margin="10,5,5,5"
                                    FontSize="13"
                                    Text="{Binding .}"
                                    VerticalOptions="Center" />
                            </DataTemplate>
                        </editors:SfComboBox.ItemTemplate>
                    </editors:SfComboBox>
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontSize="24" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                </sfCore:SfTextInputLayout>


            </Grid>

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Margin="15"
            Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="Start"
                Text="Description"
                VerticalOptions="Start" />

            <Label Text="{Binding MedicineDTO.Description}" />

            <Label
                FontAttributes="Bold"
                FontSize="15"
                HorizontalOptions="Start"
                Text="How to use"
                VerticalOptions="Start" />

            <Label
                HorizontalOptions="Start"
                Text="1 Tab Daily"
                VerticalOptions="Start" />


        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <ActivityIndicator
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                HorizontalOptions="Fill"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                Color="Goldenrod" />
            <Label
                FontAttributes="Bold"
                IsVisible="{Binding IsBusy}"
                Style="{StaticResource LabelMedium}"
                Text="Please wait..."
                TextColor="Goldenrod" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3" Margin="15">
            <Label
                FontAttributes="Bold"
                FontSize="17"
                HorizontalOptions="Start"
                Text="Select your nearest pickup point"
                VerticalOptions="Start" />


            <editors:SfComboBox
                Margin="0,10,0,0"
                ClipToBounds="True"
                DisplayMemberPath="Location"
                DropDownIconColor="{StaticResource AppGreenColor}"
                FontSize="15"
                IsClearButtonVisible="False"
                ItemsSource="{Binding ListOfMedicalCentre}"
                Placeholder="Location"
                SelectedItem="{Binding SelectedPickup}"
                Stroke="{StaticResource Tertiary}">
                <editors:SfComboBox.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Margin="10,5,5,5"
                            FontSize="13"
                            Text="{Binding Location}"
                            VerticalOptions="Center" />
                    </DataTemplate>
                </editors:SfComboBox.ItemTemplate>
            </editors:SfComboBox>
        </VerticalStackLayout>



        <VerticalStackLayout
            Grid.Row="4"
            Margin="10"
            Spacing="5">

            <Button
                Background="{StaticResource AppGreenColor}"
                BackgroundColor="{StaticResource AppGreenColor}"
                Command="{Binding CreateOrderCommand}"
                Text="+ Add to cart"
                TextColor="White" />

            <Button
                Background="{StaticResource AppGreenColor}"
                BackgroundColor="{StaticResource AppGreenColor}"
                Command="{Binding NavigateToCartItemsCommand}"
                Text="View cart items"
                TextColor="White" />
        </VerticalStackLayout>
    </Grid>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding GetMedicalCentresCommand}" EventName="Appearing" />
        <!--<toolkit:EventToCommandBehavior Command="{Binding GetPackagingCommand}" EventName="Appearing" />-->
    </ContentPage.Behaviors>
</ContentPage>