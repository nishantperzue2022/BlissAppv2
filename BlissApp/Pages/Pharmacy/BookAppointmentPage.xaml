<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Pharmacy.BookAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:viewmodel="clr-namespace:BlissApp.ViewModels"
    Title="Book Appointment"
    x:DataType="viewmodel:ConsultationViewModel"
    Background="{StaticResource BackgroudColor}"
    NavigationPage.HasNavigationBar="False"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">

    <ScrollView>


        <Grid RowDefinitions="Auto,*,*">

            <StackLayout Grid.Row="0">
                <Border
                    Margin="10"
                    Padding="10"
                    Background="White"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 5,5,5,5">
                    <Border.Shadow>
                        <Shadow Opacity="0.4" Offset="1,1" />
                    </Border.Shadow>
                    <StackLayout>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="14"
                            Style="{StaticResource LabelBold}"
                            Text="{Binding Listofmedicalcentre.Location}" />
                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="Fill"
                            Color="{StaticResource AppPrimary}" />

                        <Grid
                            Margin="15,15,15,0"
                            ColumnSpacing="10"
                            RowDefinitions="*,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                                <Label
                                    Style="{StaticResource LabelMedium}"
                                    Text="Working Hours : "
                                    VerticalOptions="Start" />
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HeightRequest="22"
                                    VerticalOptions="Center"
                                    WidthRequest="22">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FontAwesome"
                                            Glyph="{x:Static fontawesome:IconFont.ClockO}"
                                            Size="20"
                                            Color="Black" />
                                    </Image.Source>
                                </Image>
                            </Grid>

                            <Label
                                Grid.Row="1"
                                Style="{StaticResource LabelLight}"
                                Text="{Binding Listofmedicalcentre.Working_Hours}"
                                TextColor="Black" />
                        </Grid>

                        <Grid
                            Margin="15,15,15,20"
                            ColumnSpacing="10"
                            RowDefinitions="*,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource LabelMedium}"
                                    Text="Physical Address :"
                                    VerticalOptions="Start" />
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HeightRequest="22"
                                    VerticalOptions="Center"
                                    WidthRequest="22">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FontAwesome"
                                            Glyph="{x:Static fontawesome:IconFont.LocationArrow}"
                                            Size="20"
                                            Color="Black" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource LabelLight}"
                                Text="{Binding Listofmedicalcentre.Physical_Address}"
                                TextColor="Black" />
                        </Grid>




                    </StackLayout>

                </Border>

            </StackLayout>


            <Border
                Grid.Row="1"
                Margin="10"
                Background="White"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 5,5,5,5">
                <Border.Shadow>
                    <Shadow Opacity="0.4" Offset="1,1" />
                </Border.Shadow>
                <VerticalStackLayout>
                    <calendar:SfCalendar
                        x:Name="calendar"
                        Grid.Row="1"
                        HeightRequest="260"
                        MinimumDate="{Binding MinimumDate}"
                        SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                        View="Month" />


                </VerticalStackLayout>


            </Border>

            <VerticalStackLayout
                Grid.Row="2"
                Margin="15"
                VerticalOptions="End">

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="2"
                        HorizontalOptions="Fill"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center"
                        Color="Goldenrod" />
                    <Label
                        FontAttributes="Bold"
                        IsVisible="{Binding IsBusy}"
                        Style="{StaticResource LabelMedium}"
                        Text="Please wait..."
                        TextColor="Goldenrod" />
                </VerticalStackLayout>



                <Label
                    Margin="5"
                    Text="{Binding DateSelectionErrorText}"
                    TextColor="{Binding ErrorColor}" />


                <Button
                    Background="{StaticResource AppGreenColor}"
                    Command="{Binding BookConsultationCommand}"
                    Text="Book Appointment"
                    TextColor="White" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>