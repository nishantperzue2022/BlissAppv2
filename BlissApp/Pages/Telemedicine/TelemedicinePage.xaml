<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Telemedicine.TelemedicinePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    Title="Telemedicine"
    Background="{StaticResource BackgroudColor}">


    <ScrollView>


        <StackLayout>

            <VerticalStackLayout Margin="10">
                <Frame
                    Padding="10"
                    HorizontalOptions="Fill"
                    Style="{StaticResource CardView}"
                    VerticalOptions="Fill">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BookTelemedicineCommand}" />
                    </Frame.GestureRecognizers>

                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Image HeightRequest="25" WidthRequest="25">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.VideoCamera}"
                                    Size="20"
                                    Color="#009e4e" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource LabelRegular}" Text="Book Now" />
                    </VerticalStackLayout>
                </Frame>


            </VerticalStackLayout>


            <VerticalStackLayout VerticalOptions="End">
                <Label
                    Margin="20,0,0,20"
                    FontSize="Micro"
                    Style="{x:StaticResource LabelRegular}"
                    Text="*Telemedicine is offered in partnership with Bliss Healthcare Ltd."
                    TextColor="{StaticResource LabelLight}" />
            </VerticalStackLayout>


        </StackLayout>
    </ScrollView>

</ContentPage>