<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Dependants.DependantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:BlissApp.DTO.MemberModule;assembly=BlissApp.DTO"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:BlissApp.ViewModels"
    Title="Dependants"
    Background="{StaticResource BackgroudColor}"
    NavigationPage.HasNavigationBar="False">


    <ScrollView>

        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="5"
            RowDefinitions="*,Auto"
            RowSpacing="0">

            <RefreshView
                Grid.ColumnSpan="2"
                Command="{Binding GetDependantsCommand}"
                IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding listofDependants}" SelectionMode="None">


                    <CollectionView.EmptyView>
                        <ContentView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <!--<Label
                                    Text="Loading data..... !"
                           Margin="10,25,10,10"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center" />
                                <Label Text="Try again later."
                           FontAttributes="Italic"
                           FontSize="12"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center" />-->

                                <Image Margin="50" Source="empty.svg" />
                            </StackLayout>
                        </ContentView>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:MemberDTO">
                            <Grid Margin="10">
                                <Frame
                                    Padding="0"
                                    CornerRadius="20"
                                    HasShadow="True"
                                    Style="{StaticResource CardView}"
                                    VerticalOptions="Start">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DependantsViewModel}}, Path=GoToDetailsCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Padding="15"
                                        VerticalOptions="Center">

                                        <Grid ColumnSpacing="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource LabelMedium}"
                                                Text="Name" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{StaticResource LabelMedium}"
                                                Text=":" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource LabelMedium}"
                                                Text="{Binding name}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource LabelMedium}"
                                                Text="Relation" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource LabelMedium}"
                                                Text=":" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{StaticResource LabelMedium}"
                                                Text="{Binding newRelation}" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource LabelMedium}"
                                                Text="Status" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Style="{StaticResource LabelMedium}"
                                                Text=":" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Style="{StaticResource LabelMedium}"
                                                Text="{Binding status}" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Style="{StaticResource LabelMedium}"
                                                Text="Age" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Style="{StaticResource LabelMedium}"
                                                Text=":" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Style="{StaticResource LabelMedium}"
                                                Text="{Binding age}" />

                                        </Grid>

                                    </VerticalStackLayout>


                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </RefreshView>


            <ActivityIndicator
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                HorizontalOptions="Fill"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />

        </Grid>

    </ScrollView>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding GetDependantsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

</ContentPage>