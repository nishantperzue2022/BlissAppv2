<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.MedicalCentres.MedicalCentreDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
    Title="Medical Centre Details"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black"
    Style="{StaticResource OnBoardingAndRegistrationContentPages}">

    <ScrollView>
        <VerticalStackLayout>


            <StackLayout
                Grid.Row="0"
                Padding="20"
                HorizontalOptions="Fill"
                Spacing="25"
                VerticalOptions="FillAndExpand">

                <Grid
                    ColumnDefinitions="0.2*,0.6*,0.2*"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">

                    <StackLayout
                        Grid.Column="0"
                        HorizontalOptions="Fill"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Image
                            HeightRequest="12"
                            HorizontalOptions="Start"
                            Source="back"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="14"
                            HorizontalOptions="Start"
                            Style="{StaticResource LabelRegular}"
                            Text="Back"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackToFindMedicalCentresCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </StackLayout>

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Style="{StaticResource LabelMedium}"
                        Text="Medical Centre Details"
                        VerticalOptions="Center" />
                </Grid>
            </StackLayout>

            <Border
                Margin="10,10,10,10"
                Padding="10"
                HeightRequest="320"
                StrokeShape="RoundRectangle 5,5,5,5">

                <StackLayout>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,10"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Style="{StaticResource LabelBold}"
                            Text="Details" />
                    </Grid>

                    <Grid
                        Margin="15,0,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.UserCircle}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Name"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Location}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Phone}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Phone No"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Facility_Contact}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.MapPin}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="County"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.County}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Road}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Region"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Region}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,*"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.ClockO}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Working Hours"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Working_Hours}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,*"
                        ColumnSpacing="10"
                        RowDefinitions="Auto">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.LevelDown}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Physical Address"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Physical_Address}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </StackLayout>
            </Border>

            <Border
                Margin="10,10,10,10"
                Padding="10"
                HeightRequest="400"
                StrokeShape="RoundRectangle 5,5,5,5">


                <StackLayout>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Style="{StaticResource LabelBold}"
                            Text="Services" />
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Leaf}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="MO-CO"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.MO_CO}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Medkit}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Pharmacy"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Pharmacy}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Gitlab}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Laboratory"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Laboratory}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.OptinMonster}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Optical"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Optical}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Terminal}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Dental"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Dental}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Eject}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="XRAY"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.XRAY}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Bed}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="UltraSound"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.UltraSound}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Yelp}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="CT Scan"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.CTScan}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid
                        Margin="15,15,15,0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="*">
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome"
                                    Glyph="{x:Static fontawesome:IconFont.Tasks}"
                                    Size="20"
                                    Color="Black" />
                            </Image.Source>
                        </Image>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Style="{StaticResource LabelMedium}"
                            Text="Physiotherapy"
                            VerticalOptions="Start" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource LabelMedium}"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text=": " />
                                        <Span Text="{Binding Listofmedicalcentre.Physiotherapy}" />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                </StackLayout>
            </Border>

            <VerticalStackLayout
                Grid.Row="2"
                Grid.Column="0"
                Margin="10,10,10,10">
                <maps:Map
                    x:Name="map"
                    HeightRequest="250"
                    HorizontalOptions="Center"
                    IsVisible="true"
                    IsZoomEnabled="True"
                    MapType="Street"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="400" />
            </VerticalStackLayout>

            <ActivityIndicator
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                HorizontalOptions="Fill"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>