<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Account.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Change PIN"
    Background="{StaticResource BackgroudColor}"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="sfCoreLabelStyle" TargetType="sfCore:LabelStyle">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="PoppinsRegular" />
                <Setter Property="TextColor" Value="{StaticResource LabelLight}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout
        Padding="20"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <StackLayout
            HorizontalOptions="Fill"
            Spacing="10"
            VerticalOptions="Fill">

            <sfCore:SfTextInputLayout
                Margin="0,0,0,0"
                ErrorText="{Binding OldPinErrorText}"
                HasError="{Binding IsOldPinHasError}"
                Hint="Old PIN"
                Style="{StaticResource sfInputLayoutOutlineStyle}">
                <Entry
                    Margin="0"
                    IsPassword="True"
                    Keyboard="Numeric"
                    Text="{Binding OldPin}"
                    VerticalOptions="Center" />
                <sfCore:SfTextInputLayout.HintLabelStyle>
                    <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="15" />
                </sfCore:SfTextInputLayout.HintLabelStyle>
            </sfCore:SfTextInputLayout>

            <sfCore:SfTextInputLayout
                ErrorText="{Binding NewPinErrorText}"
                HasError="{Binding IsNewPinHasError}"
                Hint="New PIN"
                Style="{StaticResource sfInputLayoutOutlineStyle}">
                <Entry
                    Margin="0"
                    IsPassword="True"
                    Keyboard="Numeric"
                    Text="{Binding NewPin}"
                    VerticalOptions="Center" />
                <sfCore:SfTextInputLayout.HintLabelStyle>
                    <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="16" />
                </sfCore:SfTextInputLayout.HintLabelStyle>
            </sfCore:SfTextInputLayout>

            <sfCore:SfTextInputLayout
                ErrorText="{Binding ConfirmPinErrorText}"
                HasError="{Binding IsConfirmPinHasError}"
                Hint="Confirm PIN"
                Style="{StaticResource sfInputLayoutOutlineStyle}">
                <Entry
                    Margin="0"
                    IsPassword="True"
                    Keyboard="Numeric"
                    Text="{Binding ConfirmPin}"
                    VerticalOptions="Center" />
                <sfCore:SfTextInputLayout.HintLabelStyle>
                    <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="16" />
                </sfCore:SfTextInputLayout.HintLabelStyle>
            </sfCore:SfTextInputLayout>

            <Button
                Command="{Binding ChangePinCommand}"
                Style="{StaticResource BaseButton}"
                Text="Submit" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                Color="{StaticResource Primary}" />

        </StackLayout>
    </StackLayout>
</ContentPage>