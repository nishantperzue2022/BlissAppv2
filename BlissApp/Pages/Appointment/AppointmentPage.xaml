<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Appointment.AppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Request Appointment"
    Background="{StaticResource BackgroudColor}"
    NavigationPage.HasNavigationBar="False"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="sfCoreLabelStyle" TargetType="sfCore:LabelStyle">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="PoppinsRegular" />
                <Setter Property="TextColor" Value="{StaticResource LabelLight}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>-->

    <ScrollView>
        <StackLayout Margin="15">

            <VerticalStackLayout Spacing="15">
                <Label
                    x:Name="label"
                    Margin="12,0,0,0"
                    FontSize="12"
                    Text="Select Relation" />
                <syncfusion:SfRadioGroup x:Name="radioGroup" Margin="0,-10,0,0">
                    <syncfusion:SfRadioButton
                        x:Name="self"
                        IsChecked="False"
                        StateChanged="CheckBox_StateChanged"
                        Text="Self" />
                    <syncfusion:SfRadioButton
                        x:Name="other"
                        IsChecked="False"
                        StateChanged="CheckBox_StateChanged"
                        Text="Other" />
                </syncfusion:SfRadioGroup>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Entry
                    x:Name="txtRelation"
                    BackgroundColor="Gray"
                    IsVisible="false"
                    Text="{Binding Relation}" />

                <StackLayout x:Name="IsOtherMembers">
                    <sfCore:SfTextInputLayout
                        Margin="0,0,0,0"
                        ErrorText="{Binding FirstNameErrorText}"
                        HasError="{Binding FirstNameHasError}"
                        Hint="Family Member"
                        Style="{StaticResource sfInputLayoutOutlineStyle}">
                        <editors:SfComboBox
                            BackgroundColor="White"
                            DisplayMemberPath="FullName"
                            IsEditable="True"
                            ItemsSource="{Binding ListOfFamilyMember}"
                            SelectedItem="{Binding SelectedFamilyMember}"
                            TextMemberPath="FullName" />
                        <sfCore:SfTextInputLayout.HintLabelStyle>
                            <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="16" />
                        </sfCore:SfTextInputLayout.HintLabelStyle>
                    </sfCore:SfTextInputLayout>

                    <Label
                        HorizontalOptions="End"
                        Text="Click Here to Add Member"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddFamilyCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>


                <sfCore:SfTextInputLayout
                    Margin="0,0,0,0"
                    HeightRequest="90"
                    Hint="Date"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">

                    <DatePicker
                        Date="{Binding ProposedDate}"
                        Format="dd-MMM-yyyy"
                        HorizontalOptions="Fill"
                        MinimumDate="{Binding MinimumDate}"
                        VerticalOptions="Center" />

                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="15" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                    <sfCore:SfTextInputLayout.TrailingView>
                        <StackLayout
                            Margin="0,0,0,0"
                            HorizontalOptions="Start"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Image
                                HeightRequest="20"
                                HorizontalOptions="Start"
                                Source="seaticon"
                                VerticalOptions="Center" />

                        </StackLayout>
                    </sfCore:SfTextInputLayout.TrailingView>
                </sfCore:SfTextInputLayout>

                <sfCore:SfTextInputLayout
                    x:Name="Department"
                    Margin="0,0,0,10"
                    ErrorText="{Binding DepartmentErrorText}"
                    HasError="{Binding DepartmentHasError}"
                    Hint="Department"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">
                    <editors:SfComboBox
                        BackgroundColor="White"
                        DisplayMemberPath="Name"
                        IsEditable="True"
                        ItemsSource="{Binding ListOfDepartment}"
                        SelectedItem="{Binding SelectedDepartment}"
                        TextMemberPath="Name" />
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="16" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                </sfCore:SfTextInputLayout>

                <sfCore:SfTextInputLayout
                    Margin="0,0,0,10"
                    ErrorText="{Binding MedCentreErrorText}"
                    HasError="{Binding MedCenterHasError}"
                    Hint="Medical Centre"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">

                    <editors:SfComboBox
                        BackgroundColor="White"
                        DisplayMemberPath="Location"
                        IsEditable="True"
                        ItemsSource="{Binding ListOfMedicalCentre}"
                        SelectedItem="{Binding SelectedMedicalCentre}"
                        TextMemberPath="Location" />
                    <sfCore:SfTextInputLayout.HintLabelStyle>
                        <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="16" />
                    </sfCore:SfTextInputLayout.HintLabelStyle>
                </sfCore:SfTextInputLayout>


                <sfCore:SfTextInputLayout
                    Margin="0,0,0,0"
                    ErrorText="{Binding PriorityTimeErrorText}"
                    HasError="{Binding PriorityTimeHasError}"
                    HeightRequest="90"
                    Hint="Priority Time"
                    Style="{StaticResource sfInputLayoutOutlineStyle}">
                    <TimePicker Time="{Binding CurrentTime}" />
                </sfCore:SfTextInputLayout>


                <ActivityIndicator
                    HorizontalOptions="Fill"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />
                <Button
                    Command="{Binding BookAppointmentCommand}"
                    HorizontalOptions="Fill"
                    Style="{StaticResource BaseButton}"
                    Text="Request Appointment"
                    TextColor="White"
                    VerticalOptions="Start" />
            </VerticalStackLayout>
            <VerticalStackLayout Margin="0,80,0,0">
                <Label
                    FontSize="17"
                    HorizontalOptions="Center"
                    Style="{StaticResource LabelBold}"
                    Text="&lt;Back" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout VerticalOptions="End">
                <Button
                    Margin="0,5,0,0"
                    Command="{Binding GoToDetailsCommand}"
                    Style="{StaticResource BaseButton}"
                    Text="View Appointments" />
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding GetMedicalCentresCommand}" EventName="Appearing" />
        <toolkit:EventToCommandBehavior Command="{Binding GetFamilyMemberCommand}" EventName="Appearing" />
        <toolkit:EventToCommandBehavior Command="{Binding GetDepartmentsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
</ContentPage>