                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="dental"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Dental" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DentalCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="Radiology"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Radiology" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding X_RayCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>




                    </Grid>
                    <Grid
                        Margin="0,0,0,5"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="5"
                        RowDefinitions="*">
                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="dawanyumbani"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Dawa Nyumbani" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DawaCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>


                </VerticalStackLayout>

                <Label
                    Margin="10,10,0,10"
                    FontSize="15"
                    HorizontalOptions="Start"
                    Style="{StaticResource LabelBold}"
                    Text="Blogs &amp; Vlogs"
                    TextColor="#009e4e" />
                <Frame
                    Margin="10,0,10,0"
                    Padding="0"
                    CornerRadius="10">
                    <VerticalStackLayout Margin="10,0,10,0">
                        <Grid RowDefinitions="Auto,*">
                            <VerticalStackLayout>
                                <CarouselView
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IndicatorView="indicatorView"
                                    ItemsSource="{Binding BlogsList}">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout Margin="5">
                                                <Image
                                                    Margin="0,10,0,0"
                                                    Aspect="Fill"
                                                    HeightRequest="200"
                                                    Source="{Binding ImageUrl}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:HomePageViewModel}}, Path=GoBlogsTypeCommand}" CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label
                                                    Margin="0,10,0,0"
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource LabelBold}"
                                                    Text="{Binding Title}" />
                                                <Label HorizontalOptions="Center" Text="{Binding Description}" />
                                                <!--<Button
                                                    FontSize="10"
                                                    HeightRequest="40"
                                                    HorizontalOptions="Start"
                                                    Text="Read More"
                                                    VerticalOptions="Center" />-->
                                            </StackLayout>

                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                                <IndicatorView
                                    x:Name="indicatorView"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,10"
                                    HorizontalOptions="Center"
                                    IndicatorColor="LightGray"
                                    IndicatorSize="10"
                                    IndicatorsShape="Circle"
                                    SelectedIndicatorColor="#1f3c86"
                                    VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!--<Label
                    Margin="10,10,0,10"
                    FontSize="15"
                    HorizontalOptions="Start"
                    Style="{StaticResource LabelBold}"
                    Text="Testimonials" />-->




                <!--<WebView Margin="10,0,10,20" Source="https://skisoftsystems.com" />-->



