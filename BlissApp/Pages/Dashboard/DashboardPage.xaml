                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Optical" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpticalCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>
                    <Grid
                        Margin="0,0,0,5"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="5"
                        RowDefinitions="*">
                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
