<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:BlissApp.Control"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    xmlns:rating="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:BlissApp.ViewModels"
    Title="Bliss"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black"
    Style="{StaticResource OnBoardingAndRegistrationContentPages}">

    <Page.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="White" StatusBarStyle="DarkContent" />
    </Page.Behaviors>
    <ContentPage.BindingContext>
        <viewmodel:HomePageViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Margin="0,10,0,10">
            <Grid
                ColumnDefinitions="*,*,*"
                RowDefinitions="*"
                VerticalOptions="Center">
                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="15,0,0,0"
                    HeightRequest="22"
                    HorizontalOptions="Start"
                    Source="menu"
                    VerticalOptions="Center" />
                <Image
                    Grid.Row="0"
                    Grid.Column="1"
                    HeightRequest="35"
                    HorizontalOptions="Center"
                    Source="logo"
                    VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1">
            <Frame
                Margin="10,0,10,10"
                Padding="0"
                HeightRequest="50">
                <Grid
                    ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="20"
                    RowDefinitions="*"
                    RowSpacing="10">
                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="20"
                        HeightRequest="18"
                        HorizontalOptions="Start"
                        Source="search_3"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        Style="{StaticResource LabelLight}"
                        Text="Find Nearest Bliss Centres"
                        VerticalOptions="Center" />
                </Grid>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FindHospitalCommand}" />
                </Frame.GestureRecognizers>
            </Frame>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout
                BackgroundColor="#F0F0F0"
                Spacing="1"
                VerticalOptions="Fill">

                <VerticalStackLayout>
                    <!--<Label
                        Margin="10,10,10,0"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Style="{StaticResource LabelBold}"
                        Text="Events &amp; Offers" />-->
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <!--<Label
                        Margin="10,10,10,0"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Style="{StaticResource LabelBold}"
                        Text="Health Tips" />-->
                    <CarouselView
                        x:Name="cvBanner"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5,0,5,5">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Margin="5">
                                    <Image
                                        Aspect="AspectFill"
                                        HorizontalOptions="Fill"
                                        Source="{Binding URL}"
                                        VerticalOptions="Fill" />
                                </StackLayout>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>



                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label
                        Margin="10,10,10,0"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Style="{StaticResource LabelBold}"
                        Text="Our Services"
                        TextColor="#009e4e" />
                    <Grid
                        Margin="0,0,0,5"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="5"
                        RowDefinitions="*">
                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="consultation"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Consultation" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConsultationCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">

                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="pharmacy"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Pharmacy" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PharmacyCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>
                    <Grid
                        Margin="0,0,0,5"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="5"
                        RowDefinitions="*">
                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="Laboratory"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource LabelBold}"
                                    Text="Laboratory" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LaboratoryCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="0"
                            CornerRadius="10"
                            HeightRequest="170"
                            IsClippedToBounds="True">

                            <Grid Padding="5" RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    HeightRequest="130"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1"
                                    WidthRequest="180">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        HorizontalOptions="Center"
                                        Source="Optical"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
