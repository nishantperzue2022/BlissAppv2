<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Dashboard.Radiology"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Radiology"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">
    <ScrollView>

        <Grid
            Margin="20,5,20,0"
            RowDefinitions="*,*,*"
            RowSpacing="5">
            <Border Grid.Row="0" Stroke="#fff">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid Padding="10" RowDefinitions="Auto,Auto">
                    <Border
                        Grid.Row="0"
                        Margin="0,-5,0,0"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        StrokeThickness="1">
                        <Image
                            Aspect="Fill"
                            HorizontalOptions="Center"
                            Source="x_ray"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Row="1"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Style="{StaticResource LabelBold}"
                        Text="X-Ray" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding XrayCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Row="1" Stroke="#fff">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid Padding="10" RowDefinitions="Auto,Auto">
                    <Border
                        Grid.Row="0"
                        Margin="0,-5,0,0"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        StrokeThickness="1">
                        <Image
                            Aspect="Fill"
                            HorizontalOptions="Center"
                            Source="Ultrasound"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Row="1"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Style="{StaticResource LabelBold}"
                        Text="Ultrasound" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UltrasoundCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Row="2" VerticalOptions="End">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    Color="{StaticResource Primary}" />
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding RequestAppointmentCommand}"
                    HorizontalOptions="Fill"
                    Style="{StaticResource BaseButton}"
                    Text="Request an Appointment"
                    TextColor="White"
                    VerticalOptions="Start" />

            </VerticalStackLayout>
        </Grid>

    </ScrollView>

</ContentPage>