<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BlissApp.Pages.Dashboard.XrayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="X Ray"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black">



    <Grid RowDefinitions="*,*,*">

        <Image
            Grid.Row="0"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            Source="{Binding Image}"
            VerticalOptions="Fill" />
        <Label
            x:Name="txtConsulation"
            Grid.Row="2"
            Margin="20,0,20,0"
            FontSize="14"
            HorizontalTextAlignment="Center"
            Style="{StaticResource LabelLight}"
            Text="{Binding XrayDescription}"
            TextColor="{StaticResource Black}"
            TextType="Text" />

        <VerticalStackLayout Grid.Row="3" VerticalOptions="End">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                Color="{StaticResource Primary}" />
            <Entry IsVisible="False" Text="{Binding AppointmentType}" />
            <Button
                Margin="15"
                Command="{Binding RequestAppointmentCommand}"
                HorizontalOptions="Fill"
                Style="{StaticResource BaseButton}"
                Text="Request an Appointment"
                TextColor="White"
                VerticalOptions="Start" />

        </VerticalStackLayout>
    </Grid>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding GetXrayCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
</ContentPage>