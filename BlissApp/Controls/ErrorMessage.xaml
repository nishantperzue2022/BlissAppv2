<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="BlissApp.Control.ErrorMessage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent">



    <VerticalStackLayout
        Margin="10"
        Padding="10"
        Background="White"
        BackgroundColor="White">

        <VerticalStackLayout Spacing="10">


            <Image
                Margin="10"
                Aspect="AspectFit"
                HeightRequest="68"
                Source="error_2.png"
                WidthRequest="68" />

            <Label
                x:Name="lblMessage"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Your account has been registered successfully Your account has been registered successfully Your account has been registered successfully"
                TextColor="Black"
                VerticalOptions="Center" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button
                    x:Name="btnCancel"
                    BackgroundColor="{StaticResource AppGreenColor}"
                    BorderColor="{StaticResource AppGreenColor}"
                    BorderWidth="2"
                    Clicked="btnCancel_Clicked"
                    FontAttributes="Bold"
                    Text="Cancel"
                    TextColor="White" />

                <Button
                    x:Name="btnOk"
                    BackgroundColor="{StaticResource AppGreenColor}"
                    BorderColor="{StaticResource AppGreenColor}"
                    BorderWidth="2"
                    Clicked="btnOk_Clicked"
                    FontAttributes="Bold"
                    Text="Ok"
                    TextColor="White" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>


</toolkit:Popup>