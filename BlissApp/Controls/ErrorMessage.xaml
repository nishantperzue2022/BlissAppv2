<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="BlissApp.Control.ErrorMessage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontawesome="clr-namespace:BlissApp.Utility"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent">



    <Frame
        Margin="20"
        CornerRadius="20"
        HorizontalOptions="Center"
        MaximumWidthRequest="200"
        MinimumWidthRequest="200"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="10">


            <Image
                Margin="10"
                Aspect="AspectFit"
                HeightRequest="100"
                Source="error_1.png"
                WidthRequest="100" />

            <Label
                x:Name="lblMessage"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Your account has been registered successfully Your account has been registered successfully Your account has been registered successfully"
                TextColor="Black"
                VerticalOptions="Center" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button
                    x:Name="btnCancel"
                    BackgroundColor="{StaticResource AppGreenColor}"
                    BorderColor="{StaticResource AppGreenColor}"
                    BorderWidth="2"
                    Clicked="btnCancel_Clicked"
                    FontAttributes="Bold"
                    Text="Cancel"
                    TextColor="White" />

                <Button
                    x:Name="btnOk"
                    BackgroundColor="{StaticResource AppGreenColor}"
                    BorderColor="{StaticResource AppGreenColor}"
                    BorderWidth="2"
                    Clicked="btnOk_Clicked"
                    FontAttributes="Bold"
                    Text="Ok"
                    TextColor="White" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Frame>


</toolkit:Popup>