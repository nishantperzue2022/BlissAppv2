<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    x:Class="BlissApp.Controls.MedicineInfoPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="Transparent">

    <Frame
        Margin="20"
        Padding="15"
        BackgroundColor="Azure"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <StackLayout>
            <Label
                HorizontalOptions="Start"
                Text="Pan 40 Tablets"
                VerticalOptions="Start" />

            <Label
                HorizontalOptions="Start"
                Text="Pantaprazole"
                VerticalOptions="Start" />


            <sfCore:SfTextInputLayout
                ContainerType="Outlined"
                Hint="Enter Medicine Name"
                Style="{StaticResource sfInputLayoutOutlineStyle}">
                <editors:SfComboBox>
                    <editors:SfComboBox.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Panadol</x:String>
                            <x:String>Acetaminophen</x:String>
                            <x:String>azithromycin</x:String>
                            <x:String>amoxicillin</x:String>
                            <x:String>fluoxetine</x:String>
                            <x:String>sertralin</x:String>
                        </x:Array>
                    </editors:SfComboBox.ItemsSource>
                </editors:SfComboBox>
                <sfCore:SfTextInputLayout.HintLabelStyle>
                    <sfCore:LabelStyle FontFamily="PoppinsRegular" FontSize="15" />
                </sfCore:SfTextInputLayout.HintLabelStyle>
            </sfCore:SfTextInputLayout>




            <Button Text="Add to cart" />

            <Label
                HorizontalOptions="Start"
                Text="Description"
                VerticalOptions="Start" />

            <Label HorizontalTextAlignment="Center" Text="Often used for ear infections, pneumonia, and urinary tract infections" />

            <Label
                HorizontalOptions="Start"
                Text="How to use"
                VerticalOptions="Start" />

            <Label
                HorizontalOptions="Start"
                Text="1 Tab Daily"
                VerticalOptions="Start" />
        </StackLayout>
    </Frame>
</toolkit:Popup>