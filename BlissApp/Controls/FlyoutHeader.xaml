<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BlissApp.Controls.FlyoutHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:BlissApp.ViewModels">
    <ContentView.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <sfavatar:SfAvatarView
                Grid.Column="0"
                Margin="15,0,0,0"
                ContentType="Custom"
                CornerRadius="35"
                HeightRequest="70"
                HorizontalOptions="Center"
                ImageSource="{Binding PhotoPath}"
                VerticalOptions="Center"
                WidthRequest="70" />

            <VerticalStackLayout Grid.Column="1" Padding="15">
                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="{Binding MemberName}"
                    TextColor="Black" />
                <!--<Label Text="{Binding SchemeName}" TextColor="Black"  FontAttributes="Bold" FontSize="Small" />-->
                <Label FontSize="Small" Text="View Profile" />
            </VerticalStackLayout>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ProfileViewModel}}, Path=ViewProfileCommand}" CommandParameter="{Binding .}" />
            </Grid.GestureRecognizers>
        </Grid>
    </ContentView.Content>
</ContentView>
